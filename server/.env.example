# Postgres connection string.
DATABASE_URL=postgresql://USER@localhost:5432/loupe
# Anthropic key used for every account's Claude calls. Server side only.
ANTHROPIC_API_KEY=
# Optional. Defaults shown.
PORT=8080
HOST=0.0.0.0
MONTHLY_TOKEN_CAP=3000000
SESSION_DAYS=90
# Proxy hops in front of the server. Set to 1 on Railway so rate limits see client IPs.
TRUSTED_PROXY_HOPS=0
