# Where the index, embeddings and review pages are written. Gitignored.
LOUPE_DATA_DIR=./data

# Leave blank to use the system Photos library of the logged-in macOS user.
LOUPE_PHOTOS_LIBRARY=

# Short name of the owner's macOS account (`whoami` there). Loupe refuses to
# open a Photos library in any other account.
LOUPE_OWNER_MACOS_USER=

# Name of the Photos folder that holds every album Loupe creates.
LOUPE_ALBUM_FOLDER=Loupe

# Used from M10 on (hooks, week plan). Owner approved sending her content to Claude.
ANTHROPIC_API_KEY=

# Loupe.app only. The Loupe server that holds accounts and the Claude key.
# https:// in production; http://localhost:<port> while developing server/.
LOUPE_SERVER_URL=
